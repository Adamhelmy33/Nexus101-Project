# ─────────────────────────────────────────────────────
# Nexus 101 — Environment Variables Template
# ─────────────────────────────────────────────────────
# 1. Copy this file → .env  (this file is committed; .env is NEVER committed)
# 2. Fill in your real keys
# ─────────────────────────────────────────────────────

# ── Supabase (when you connect the real backend) ─────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhb…public_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhb…service_role_key   # SERVER ONLY — never expose to browser

# Frontend uses these (must be VITE_-prefixed):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhb…public_anon_key

# ── Paymob (find these in https://accept.paymob.com/portal2) ──
# Settings → Account Info →
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret    # used by paymob-webhook to verify callbacks

# Developers → Payment Integrations → Integration ID for each method:
PAYMOB_INTEGRATION_CARD=12345
PAYMOB_INTEGRATION_WALLET=12346
PAYMOB_INTEGRATION_KIOSK=12347                # Fawry / kiosk

# Developers → iFrame → ID
PAYMOB_IFRAME_ID=987654

# ── AI (Study Buddy + Custom Course Generator) ────
ANTHROPIC_API_KEY=sk-ant-…                    # for Claude chat + syllabus parsing + segmenter
OPENAI_API_KEY=sk-…                            # for embeddings (text-embedding-3-small)

# ── Bunny.net Stream (Phase 3 — video infrastructure) ──
# Get these from https://dash.bunny.net → Stream → Library → Settings
BUNNY_LIBRARY_ID=12345                        # Stream library ID (number)
BUNNY_PULL_ZONE_HOSTNAME=vz-12345.b-cdn.net   # CDN hostname for the library
BUNNY_SECURITY_KEY=long_random_string         # Token Authentication key (Pull Zone → Security)
BUNNY_API_KEY=xxxxxxxx-xxxx-xxxx              # Account-wide API key (Account → API Keys)
BUNNY_WEBHOOK_SECRET=any_strong_random_string # Custom secret you set in Bunny webhook config
BUNNY_TOKEN_TTL_SEC=3600                      # Signed URL lifetime (default 1 hour)

# ── App config (already used) ──────────────────────
VITE_APP_NAME=Nexus 101
VITE_WHATSAPP_NUMBER=201000000000
VITE_SUPPORT_EMAIL=support@nexus101.com
